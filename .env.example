# Public site URL (canonicals, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://solarhubtechnology.com

# Where form enquiries are emailed (Gmail works). No paid plan needed.
CONTACT_TO_EMAIL=solarhubtechnology@gmail.com
NEXT_PUBLIC_CONTACT_TO_EMAIL=solarhubtechnology@gmail.com

# Optional: Web3Forms access key (https://web3forms.com) — tried first if set.
# Form always falls back to free FormSubmit → your Gmail.
WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 — free, works on cPanel / any host.
# 1. Create a GA4 property at https://analytics.google.com
# 2. Copy Measurement ID (G-XXXXXXXX)
# 3. Set below (and in cPanel / hosting env if available)
# Visitors must Accept cookies before GA loads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional cPanel-only: if Node /api/contact is unavailable, set to PHP mailer:
# NEXT_PUBLIC_CONTACT_ENDPOINT=/contact-mail.php
